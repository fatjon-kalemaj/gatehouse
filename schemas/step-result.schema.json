{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fatjon-kalemaj/gatehouse/schemas/step-result.schema.json",
  "title": "Step result",
  "description": "What every worker agent reports back to the orchestrator before the next step starts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "status", "summary", "output", "issues"],
  "properties": {
    "agent": {"type": "string", "description": "The worker's name, as on the roster."},
    "status": {"enum": ["ok", "needs_review", "failed"]},
    "summary": {"type": "string", "maxLength": 400},
    "output": {
      "type": "object",
      "description": "Step-specific fields. Always includes the path of the artifact written.",
      "required": ["artifact"],
      "properties": {"artifact": {"type": "string"}}
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high"]},
          "message": {"type": "string"}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
